{
  "name": "iot-haus",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.server.json && node dist/server/index.js",
    "dev:broker": "node scripts/dev-broker.mjs",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t iot-haus .",
    "docker:run": "docker run -d --name iot-haus -p 3000:3000 -v iot-haus-daten:/var/lib/mosquitto iot-haus",
    "docker:stop": "docker stop iot-haus && docker rm iot-haus",
    "docker:logs": "docker logs -f iot-haus",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "next": "15.5.25",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.2",
    "aedes": "^1.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "nanoid": "^3.3.18",
    "ip-address": "^10.7.0",
    "sharp": "^0.35.4"
  }
}

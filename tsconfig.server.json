{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "incremental": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/domain/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
